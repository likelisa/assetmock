LLM_BASE_URL=https://aiping.cn/api/v1
LLM_MODEL=DeepSeek-V4.1-Flash
LLM_API_KEY=
DATABASE_PATH=./data/life-simulator.sqlite
# HTTPS deployment: set true. Keep false for local HTTP.
COOKIE_SECURE=false
# Optional, for reverse proxies: https://your-domain.example
# APP_ORIGIN=

# Doubao Search Custom API Key (separate from AIPing)
DOUBAO_SEARCH_API_KEY=

# Financial Associates 独立产品数据库（不使用原产品目录）
DATABASE_URL="file:./financial-associates.db"
APP_TIMEZONE="Asia/Shanghai"
# 可选：管家单独配置；留空时复用 LLM_*，图像模型另配
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

# Optional: Python 3 executable path (no command-line arguments).
# Automatically checks python3, python, and py -3 when empty.
PYTHON_EXECUTABLE=

# 统一买车规划预览：完成两名独立用户验收后设为 1，并重新构建前端
NEXT_PUBLIC_GOAL_FUNDING_ENABLED=0

model SimulationOpening {
  id String @id
  workspaceId String
  sessionId String
  body String
  createdAt DateTime @default(now())
  @@index([workspaceId, sessionId])
}
model SimulationReport {
  worldlineAnalysisJson String?
  runId String @id
  workspaceId String
  sessionId String
  goalId String?
  version Int @default(-1)
  sourceJson String
  reportJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workspaceId, sessionId])
}

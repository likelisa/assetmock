generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  paperAccounts         PaperAccount[]
  paperMarketDrafts      PaperMarketDraft[]
  replayDatasets        PaperReplayDataset[]
  id                    String                 @id @default(cuid())
  professionalRevision  Int                    @default(0)
  businessMigratedAt    DateTime?
  dataEpoch             Int                    @default(0)
  portfolioRevision     Int                    @default(0)
  transactionRevision   Int                    @default(0)
  ledgerConfirmedAt     DateTime?
  ledgerHeadersJson     String                 @default("{}")
  promptOverridesJson   String                 @default("{}")
  multiGoalConsentAt    DateTime?
  profile               Profile?
  assets                Asset[]
  liabilities           Liability[]
  goals                 Goal[]
  auditEvents           AuditEvent[]
  calculationSnapshots  CalculationSnapshot[]
  tasks                 AgentTask[]
  diagnoses             Diagnosis[]
  planSets              PlanSet[]
  scenarioResults       ScenarioResult[]
  actions               Action[]
  agentSessions         AgentSession[]
  goalDecisions         GoalDecision[]
  futurePlanningReports FuturePlanningReport[]
  transactions          Transaction[]
  cashflowAnalyses      CashflowAnalysis[]
  planningMemories      PlanningMemory[]
  managerState          ManagerState?
  insurancePolicies     InsurancePolicy[]
  holdingDetails        HoldingDetail[]
  professionalEvaluations ProfessionalEvaluation[]
  productSelections     ProductSelection[]
  managerReminders      ManagerReminder[]
  carDecisions          CarDecision[]
  carReservations       CarFundingReservation[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// Simulated trading is a separate ledger. No relation to real Asset or Transaction.
model MarketInstrument {
  id String @id
  name String
  board String
  source String
  updatedAt DateTime @updatedAt
  quotes MarketQuote[]
  states MarketDailyState[]
  orders PaperOrder[]
  positions PaperPosition[]
  watchlists PaperWatchlist[]
  replayBars PaperReplayBar[]
  conditions PaperCondition[]
}

model MarketCalendar {
  day String @id
  isOpen Boolean
  source String
  verifiedAt DateTime
}

model MarketDailyState {
  id String @id @default(cuid())
  instrumentId String
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id])
  day String
  status String
  eventCoverage Boolean @default(false)
  lowerMinor BigInt
  upperMinor BigInt
  source String
  verifiedAt DateTime
  @@unique([instrumentId, day])
}

model MarketQuote {
  id String @id
  instrumentId String
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id])
  provider String
  sourceAt DateTime
  fetchedAt DateTime
  priceMinor BigInt
  previousMinor BigInt
  bidMinor BigInt
  askMinor BigInt
  bidQuantity Int
  askQuantity Int
  lowerMinor BigInt
  upperMinor BigInt
  fills PaperFill[]
  consumptions PaperQuoteConsumption[]
  @@index([instrumentId, sourceAt])
}

model PaperRuleVersion {
  id String @id
  configJson String
  source String
  createdAt DateTime @default(now())
  accounts PaperAccount[]
  orders PaperOrder[]
}

model MarketReviewRecord {
  id String @id @default(cuid())
  dataJson String
  createdAt DateTime @default(now())
}

model PaperAccount {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status String @default("ACTIVE")
  purpose String @default("MANUAL")
  mode String @default("LIVE")
  name String @default("手动模拟账户")
  initialMinor BigInt
  cashMinor BigInt
  frozenMinor BigInt @default(0)
  realizedMinor BigInt @default(0)
  feesMinor BigInt @default(0)
  version Int @default(0)
  ruleId String
  rule PaperRuleVersion @relation(fields: [ruleId], references: [id])
  health String @default("OK")
  createdAt DateTime @default(now())
  archivedAt DateTime?
  orders PaperOrder[]
  positions PaperPosition[]
  entries PaperCashEntry[]
  previews PaperPreview[]
  notes PaperReviewNote[]
  snapshots PaperEquitySnapshot[]
  watchlists PaperWatchlist[]
  requests PaperRequest[]
  adjustments PaperAdjustment[]
  consumptions PaperQuoteConsumption[]
  operationalEvents PaperOperationalEvent[]
  reconciliations PaperReconciliation[]
  experiment PaperStrategyExperiment?
  replaySession PaperReplaySession?
  conditions PaperCondition[]
  @@unique([workspaceId, id])
}

model PaperOrder {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  instrumentId String
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id])
  side String
  limitMinor BigInt
  quantity Int
  filled Int @default(0)
  turnoverMinor BigInt @default(0)
  feesMinor BigInt @default(0)
  frozenMinor BigInt @default(0)
  status String @default("OPEN")
  day String
  ruleId String
  rule PaperRuleVersion @relation(fields: [ruleId], references: [id])
  reason String @default("")
  createdAt DateTime @default(now())
  fills PaperFill[]
  events PaperOrderEvent[]
  condition PaperCondition?
  strategyRun PaperStrategyRun?
  @@unique([workspaceId, id])
  @@unique([workspaceId, accountId, id])
  @@index([status, day])
}

model PaperOrderEvent {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  orderId String
  order PaperOrder @relation(fields: [workspaceId, accountId, orderId], references: [workspaceId, accountId, id], onDelete: Cascade)
  type String
  detail String
  createdAt DateTime @default(now())
}

model PaperFill {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  orderId String
  order PaperOrder @relation(fields: [workspaceId, accountId, orderId], references: [workspaceId, accountId, id], onDelete: Cascade)
  quoteId String
  quote MarketQuote @relation(fields: [quoteId], references: [id])
  quantity Int
  priceMinor BigInt
  feeMinor BigInt
  costMinor BigInt
  realizedMinor BigInt
  createdAt DateTime @default(now())
  @@unique([orderId, quoteId])
}

model PaperPosition {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  instrumentId String
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id])
  quantity Int @default(0)
  frozen Int @default(0)
  costMinor BigInt @default(0)
  lots PaperPositionLot[]
  @@unique([accountId, instrumentId])
  @@unique([workspaceId, accountId, id])
}

model PaperPositionLot {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  positionId String
  position PaperPosition @relation(fields: [workspaceId, accountId, positionId], references: [workspaceId, accountId, id], onDelete: Cascade)
  quantity Int
  sellableOn String
  createdAt DateTime @default(now())
}

model PaperCashEntry {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  eventKey String @unique
  type String
  amountMinor BigInt
  balanceMinor BigInt
  reference String
  createdAt DateTime @default(now())
}

model PaperPreview {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  version Int
  epoch Int
  inputJson String
  resultJson String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PaperRequest {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  key String
  signature String
  resultJson String
  @@unique([workspaceId, key])
}

model PaperQuoteConsumption {
  id String @id @default(cuid())
  accountId String
  account PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  quoteId String
  quote MarketQuote @relation(fields: [quoteId], references: [id])
  side String
  quantity Int
  @@unique([accountId, quoteId, side])
}

model PaperWatchlist {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  instrumentId String
  instrument MarketInstrument @relation(fields: [instrumentId], references: [id])
  @@unique([accountId, instrumentId])
}

model PaperEquitySnapshot {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  key String
  cashMinor BigInt
  marketMinor BigInt?
  equityMinor BigInt?
  quality String
  evidenceJson String
  createdAt DateTime @default(now())
  @@unique([accountId, key])
}

model PaperReviewNote {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  content String
  createdAt DateTime @default(now())
}

model PaperAdjustment {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  eventKey String
  instrumentId String
  kind String
  cashMinor BigInt
  quantity Int
  source String
  createdAt DateTime @default(now())
  @@unique([accountId, eventKey])
}

model PaperWorkerLease {
  id String @id
  owner String
  token Int @default(0)
  expiresAt DateTime
  heartbeatAt DateTime
  startedAt DateTime @default(now())
  status String
  error String @default("")
}

model MarketSourceHealth {
  provider String @id
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  failureCount Int @default(0)
  error String @default("")
  updatedAt DateTime @updatedAt
}

model PaperOperationalEvent {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  type String
  status String @default("RECORDED")
  detailJson String
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

model PaperReconciliation {
  id String @id @default(cuid())
  workspaceId String
  accountId String
  account PaperAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)
  accountVersion Int
  issuesJson String
  status String
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

model PaperMarketDraft {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataJson String
  signature String
  status String @default("PENDING")
  version Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  publishedAt DateTime?
}

model PaperBenchmarkPoint {
  id String @id @default(cuid())
  day String
  symbol String @default("sh000300")
  closeMinor BigInt
  source String
  createdAt DateTime @default(now())
  @@unique([symbol, day])
}

model Transaction {
  id                   String    @id @default(cuid())
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  direction            String
  amountMinor          BigInt
  occurredOn           DateTime
  description          String
  category             String
  specialKind          String    @default("NONE")
  analysisTreatment    String    @default("COUNT")
  source               String    @default("MANUAL")
  classificationSource String    @default("FALLBACK")
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([workspaceId, occurredOn, deletedAt])
  @@index([workspaceId, direction, category])
}

model CashflowAnalysis {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  periodKind          String
  periodStart         DateTime
  periodEnd           DateTime
  transactionRevision Int
  statisticsJson      String
  agentReportJson     String
  model               String
  promptVersion       String
  createdAt           DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, periodStart, periodEnd])
}

model AgentSession {
  id             String            @id @default(cuid())
  workspaceId    String
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title          String
  objective      String?
  kind           String            @default("WEALTH_TASK")
  agentKey       String?
  decisionId     String?
  version        Int               @default(1)
  summaryJson    String            @default("{}")
  runs           AgentRun[]
  goalDraftJson  String            @default("{}")
  goalId         String?
  goal           Goal?             @relation(fields: [goalId], references: [id], onDelete: SetNull)
  status         String            @default("ACTIVE")
  sourceRevision Int
  messages       AgentMessage[]
  steps          AgentStep[]
  constraints    AgentConstraint[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([workspaceId, id])
  @@index([workspaceId, updatedAt])
}

model AgentConstraint {
  id          String                    @id @default(cuid())
  sessionId   String
  session     AgentSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content     String
  category    String
  status      String                    @default("ACTIVE")
  version     Int                       @default(1)
  validUntil  DateTime?
  confirmedAt DateTime                  @default(now())
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  history     AgentConstraintRevision[]

  @@index([sessionId, createdAt])
}

model AgentConstraintRevision {
  id           String          @id @default(cuid())
  constraintId String
  constraint   AgentConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade)
  version      Int
  content      String
  category     String
  status       String
  validUntil   DateTime?
  confirmedAt  DateTime

  @@unique([constraintId, version])
}

model AgentMessage {
  id             String       @id @default(cuid())
  sessionId      String
  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientMessageId String?
  runId          String?
  displayJson    String @default("{}")
  role           String
  content        String
  sourceRevision Int
  createdAt      DateTime     @default(now())

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, createdAt])
}

model AgentStep {
  id             String       @id @default(cuid())
  sessionId      String
  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  runId          String?
  sequence       Int
  toolName       String
  status         String       @default("PROCESSING")
  inputJson      String
  outputJson     String?
  errorCode      String?
  durationMs     Int?
  sourceRevision Int
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

model ScenarioResult {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planSetId      String
  planKey        String
  sourceRevision Int
  resultJson     String
  createdAt      DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model Action {
  id                    String           @id @default(cuid())
  sourceKey             String?          @unique
  workspaceId           String
  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId                String?
  goal                  Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  generationTaskId      String
  planSetId             String?
  planKey               String?
  diagnosisId           String?
  detailsJson           String?
  feedback              ActionFeedback[]
  sourceRevision        Int
  kind                  String
  title                 String
  reason                String
  amountMinor           BigInt?
  priority              Int
  dueDate               DateTime?
  status                String           @default("PROPOSED")
  verificationType      String
  productConditionsJson String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([workspaceId, generationTaskId])
  @@index([workspaceId, createdAt])
  @@index([goalId, createdAt])
  managerReminders ManagerReminder[]
  @@unique([workspaceId, id])
}

model ActionFeedback {
  id         String   @id @default(cuid())
  actionId   String
  action     Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  reason     String
  createdAt  DateTime @default(now())

  @@index([actionId, createdAt])
}

model AgentTask {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type           String
  status         String    @default("PROCESSING")
  sourceRevision Int
  resultId       String?
  errorCode      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([workspaceId, createdAt])
}

model Diagnosis {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRevision Int
  promptVersion  String
  model          String
  mode           String
  resultJson     String
  createdAt      DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model PlanSet {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId          String?
  goal            Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  sourceRevision  Int
  promptVersion   String
  model           String
  mode            String
  resultJson      String
  selectedPlanKey String?
  recommendedPlanKey String?
  futurePlanningReports FuturePlanningReport[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([goalId, createdAt])
}

model FuturePlanningReport {
  id                      String    @id @default(cuid())
  workspaceId             String
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId                  String?
  goal                    Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  planSetId               String?
  planSet                 PlanSet?  @relation(fields: [planSetId], references: [id], onDelete: SetNull)
  planKey                 String?
  sourceRevision          Int
  promptVersion           String
  model                   String
  mode                    String
  informationCompleteness String
  resultText              String
  resultJson              String?
  adoptedAt               DateTime?
  createdAt               DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([goalId, createdAt])
  @@index([planSetId, createdAt])
}

model CalculationSnapshot {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceRevision Int
  formulaVersion String
  resultJson     String
  createdAt      DateTime  @default(now())

  @@unique([workspaceId, sourceRevision, formulaVersion])
  @@index([workspaceId, createdAt])
}

model Profile {
  id                       String    @id @default(cuid())
  workspaceId              String    @unique
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  age                      Int?
  familyStatus             String    @default("SINGLE")
  riskLevel                String    @default("BALANCED")
  baseCurrency             String    @default("CNY")
  stableMonthlyIncomeMinor BigInt    @default(0)
  otherMonthlyIncomeMinor  BigInt    @default(0)
  rentExpenseMinor         BigInt    @default(0)
  transportExpenseMinor    BigInt    @default(0)
  essentialExpenseMinor    BigInt    @default(0)
  source                   String    @default("USER_INPUT")
  asOf                     DateTime  @default(now())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Asset {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId                String?
  goal                  Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  type                  String
  name                  String
  currentValueMinor     BigInt
  currency              String    @default("CNY")
  liquidityLevel        String
  riskLevel             Int
  isInvestable          Boolean   @default(true)
  isAdjustable          Boolean   @default(true)
  holdingDetail         HoldingDetail?
  classificationSource  String    @default("RULE_FALLBACK")
  classificationVersion String    @default("asset-classifier-v0")
  source                String    @default("USER_INPUT")
  asOf                  DateTime  @default(now())
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workspaceId, deletedAt])
  @@index([goalId])
  reservedFunds CarFundingReservation[]
  decisionReasons DecisionReason[]
  decisionConstraints DecisionConstraint[]
  @@unique([workspaceId, id])
}

model Liability {
  id                      String    @id @default(cuid())
  workspaceId             String
  workspace               Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type                    String
  name                    String
  outstandingBalanceMinor BigInt
  isInstallment           Boolean   @default(false)
  monthlyPaymentMinor     BigInt    @default(0)
  remainingMonths         Int?
  totalRepaymentMinor     BigInt?
  principalMinor          BigInt?
  interestMinor           BigInt?
  repaymentMethod         String?
  source                  String    @default("USER_INPUT")
  asOf                    DateTime  @default(now())
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([workspaceId, deletedAt])
}

model Goal {
  id                       String                 @id @default(cuid())
  workspaceId              String
  workspace                Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets                   Asset[]
  agentSessions            AgentSession[]
  futurePlanningReports    FuturePlanningReport[]
  planSets                 PlanSet[]
  actions                  Action[]
  type                     String
  name                     String
  targetAmountMinor        BigInt
  targetAmountSource       String                 @default("USER_INPUT")
  targetDate               DateTime
  preparedAmountMinor      BigInt                 @default(0)
  monthlyContributionMinor BigInt                 @default(0)
  priority                 Int                    @default(2)
  priorityNote             String?
  priorityConfirmedAt      DateTime?
  isFlexible               Boolean                @default(false)
  source                   String                 @default("USER_INPUT")
  asOf                     DateTime               @default(now())
  deletedAt                DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([workspaceId, deletedAt])
  decisionConstraints DecisionConstraint[]
  @@unique([workspaceId, id])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  action      String
  revision    Int
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// Draft facts are distinct from real balances; adoption never moves money.
model CarDecision {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId                String?
  status                String    @default("DRAFT")
  version               Int       @default(1)
  sourceRevision        Int       @default(0)
  factsJson             String
  conversationJson      String    @default("[]")
  resumeKey             String?   @unique
  goalSessionId         String?   @unique
  viewStage             String    @default("facts")
  dependenciesJson      String    @default("{}")
  fieldEvidenceJson     String    @default("{}")
  evaluationJson        String?
  activePlanId          String?
  purchaseJson          String?
  plans                 CarPlanVersion[]
  reviews               CarMonthlyReview[]
  reservations          CarFundingReservation[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workspaceId, updatedAt])
  structuredConstraints DecisionConstraint[]
  evaluations CarEvaluationRecord[]
  @@unique([workspaceId, id])
}

model CarPlanVersion {
  id                  String      @id @default(cuid())
  decisionId          String
  decision            CarDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  version             Int
  sourceRevision      Int
  transactionRevision Int
  snapshotJson        String
  factsJson           String
  reason              String
  adoptedAt           DateTime    @default(now())

  @@unique([decisionId, version])
  structuredReasons DecisionReason[]
  structuredConstraints DecisionConstraint[]
  assumptions PlanAssumption[]
}

model CarFundingReservation {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decisionId  String
